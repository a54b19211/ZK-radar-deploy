[Unit]
Description=Data-Fabric attachment text (MinerU cloud)
After=network-online.target
StartLimitIntervalSec=0

[Service]
WorkingDirectory=/data/projects/fabric
EnvironmentFile=%h/.config/datafabric-publication/runtime.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/data/projects/fabric/.venv/bin/python -m run.attachments --loop --batch 20 --poll-seconds 60
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
