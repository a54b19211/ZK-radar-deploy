[Unit]
Description=BioRadar API (:18100)
After=network-online.target
StartLimitIntervalSec=0

[Service]
WorkingDirectory=/data/projects/BioRadar
EnvironmentFile=%h/.config/bioradar/radar.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/data/projects/BioRadar/.venv/bin/uvicorn bioradar.app:app --app-dir services --host 127.0.0.1 --port 18100
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
