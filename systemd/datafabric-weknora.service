[Unit]
Description=Data-Fabric WeKnora bridge (:18564)
After=network-online.target
StartLimitIntervalSec=0

[Service]
WorkingDirectory=/data/projects/fabric
Environment=PYTHONUNBUFFERED=1
Environment=WEKNORA_KDD_CONFIG=%h/.config/weknora-kdd/runtime.json
ExecStart=/data/projects/fabric/.venv/bin/python -m uvicorn weknora.app:app_factory --factory --host 127.0.0.1 --port 18564 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
