[Unit]
Description=Data-Fabric scheduler: due source watches become fetch runs
After=network-online.target
StartLimitIntervalSec=0

[Service]
WorkingDirectory=/data/projects/fabric
EnvironmentFile=%h/.config/datafabric-publication/runtime.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/data/projects/fabric/.venv/bin/python -m run.scheduler --poll-seconds 30
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
