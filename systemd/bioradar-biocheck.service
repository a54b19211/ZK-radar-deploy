[Unit]
Description=BioCheck (:18562)
After=network-online.target
StartLimitIntervalSec=0

[Service]
WorkingDirectory=/data/projects/BioCheck
EnvironmentFile=%h/.config/bioradar/biocheck.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/data/projects/BioCheck/.venv/bin/uvicorn app.service:app --host 127.0.0.1 --port 18562
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
