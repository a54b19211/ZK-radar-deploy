[Unit]
Description=Atlas API (:8100)
After=network-online.target
StartLimitIntervalSec=0

[Service]
WorkingDirectory=/data/projects/atlas
EnvironmentFile=%h/.config/atlas/atlas.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/data/projects/atlas/.venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8100
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
